{
	"schemaVersion": 1,
	"id": "mcpfabric",
	"version": "${version}",
	"name": "Minecraft Automation",
	"description": "Structured observation and verified Minecraft automation through a local MCP bridge.",
	"authors": [
		"dabinayo",
		"zedoCN"
	],
	"contact": {
		"homepage": "https://github.com/zedoCN/minecraft-automation",
		"issues": "https://github.com/zedoCN/minecraft-automation/issues",
		"sources": "https://github.com/zedoCN/minecraft-automation"
	},
	"icon": "assets/mcpfabric/icon.png",
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.mcpfabric.platform.FabricEntrypoint"
		],
		"client": [
			"dev.mcpfabric.client.FabricClientEntrypoint"
		]
	},
	"mixins": [
		"mcpfabric.mixins.json",
		{
			"config": "mcpfabric.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_dep}",
		"java": ">=${java_dep}",
		"fabric-api": "*"
	}
}
