{
  "name": "mcpfabric-mcp-server",
  "version": "0.3.0-zedo.2",
  "description": "MCP server that bridges AI agents to the mcpfabric Minecraft mod, exposing full read & control of the game as MCP tools.",
  "type": "module",
  "bin": {
    "mcpfabric": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/*.test.js",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types --watch src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "minecraft",
    "fabric",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "hono": "^4.12.34",
    "ip-address": "^10.4.0"
  }
}
